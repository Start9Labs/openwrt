Subject: [PATCH] fix build fail temporarily

---
 drivers/mtd/Kconfig      | 2 +-
 drivers/mtd/mtdpart.c    | 2 +-
 drivers/net/phy/Kconfig  | 2 +-
 drivers/platform/Kconfig | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/mtd/Kconfig b/drivers/mtd/Kconfig
index 7e4a3fa1dfd0..f6a7f770a5ec 100644
--- a/drivers/mtd/Kconfig
+++ b/drivers/mtd/Kconfig
@@ -27,7 +27,7 @@ config MTD_SPLIT_FIRMWARE_NAME
 	depends on MTD_SPLIT_FIRMWARE
 	default "firmware"
 
-source "drivers/mtd/mtdsplit/Kconfig"
+# source "drivers/mtd/mtdsplit/Kconfig"
 
 endmenu
 
diff --git a/drivers/mtd/mtdpart.c b/drivers/mtd/mtdpart.c
index b21f73d525c3..fa25b1133473 100644
--- a/drivers/mtd/mtdpart.c
+++ b/drivers/mtd/mtdpart.c
@@ -21,7 +21,7 @@
 #include <linux/of_platform.h>
 
 #include "mtdcore.h"
-#include "mtdsplit/mtdsplit.h"
+/* #include "mtdsplit/mtdsplit.h" */
 
 /*
  * MTD methods which simply translate the effective address and pass through
diff --git a/drivers/net/phy/Kconfig b/drivers/net/phy/Kconfig
index 91c03346ab70..d9e878fcd985 100644
--- a/drivers/net/phy/Kconfig
+++ b/drivers/net/phy/Kconfig
@@ -94,7 +94,7 @@ config AR8216_PHY_LEDS
 	bool "Atheros AR8216 switch LED support"
 	depends on (AR8216_PHY && LEDS_CLASS)
 
-source "drivers/net/phy/b53/Kconfig"
+# source "drivers/net/phy/b53/Kconfig"
 
 config IP17XX_PHY
 	tristate "Driver for IC+ IP17xx switches"
diff --git a/drivers/platform/Kconfig b/drivers/platform/Kconfig
index 3ea408c6d9da..e7c79eb57e56 100644
--- a/drivers/platform/Kconfig
+++ b/drivers/platform/Kconfig
@@ -15,4 +15,4 @@ source "drivers/platform/surface/Kconfig"
 
 source "drivers/platform/x86/Kconfig"
 
-source "drivers/platform/mikrotik/Kconfig"
+# source "drivers/platform/mikrotik/Kconfig"
